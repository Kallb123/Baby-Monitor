{
  "name": "baby-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-camera baby monitor web app backed by Home Assistant and go2rtc",
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --cache --fix",
    "format": "prettier --write src/ server/ shared/",
    "format:check": "prettier --check src/ server/ shared/",
    "check": "run-s format:check lint type-check test",
    "bump": "node scripts/bump.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "fastify": "^5.12.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.88.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
