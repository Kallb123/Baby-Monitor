# Copy to .env and fill in. .env is git-ignored. It is read by `npm run dev`,
# `npm start` and `docker compose` (which overrides DATA_DIR and GO2RTC_URL).

# Optional Compose services to start: demo (fake camera), homeassistant.
# COMPOSE_PROFILES=demo

# Docker Compose: app image tag on ghcr.io/kallb123/baby-monitor. Defaults to
# latest; pin a sha-<commit> tag to hold a known-good build.
# BABY_MONITOR_TAG=latest

# Home Assistant base URL and a long-lived access token
# (HA profile page -> Security -> Long-lived access tokens).
# Leave blank to run without temperature / cry data.
# Use an IP or a regular DNS name: `.local` (mDNS) names do not resolve inside
# the Docker image.
# Docker Compose defaults this to http://localhost:8123 (the bundled HA profile).
# HA_URL=http://192.168.1.10:8123
HA_TOKEN=

# go2rtc API, which turns RTSP camera feeds into WebRTC for the browser.
GO2RTC_URL=http://localhost:1984

# API server. The Vite dev server proxies /api to this port.
PORT=3000
HOST=0.0.0.0

# Where config.json is stored.
DATA_DIR=./data
