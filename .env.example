# Copy to .env and fill in. .env is git-ignored. It is read by `npm run dev`,
# `npm start` and `docker compose` (which overrides DATA_DIR to /data).

# Optional Compose services to start: demo (fake camera), homeassistant.
# COMPOSE_PROFILES=demo

# Docker Compose: app image tag on ghcr.io/kallb123/baby-monitor. Defaults to
# latest; pin a sha-<commit> tag to hold a known-good build.
# BABY_MONITOR_TAG=latest

# Home Assistant base URL and a long-lived access token
# (HA profile page -> Security -> Long-lived access tokens).
# Leave blank to run without temperature / cry data.
# Use an IP or a regular DNS name: `.local` (mDNS) names do not resolve inside
# the Docker image.
# Docker Compose defaults this to http://localhost:8123 (the bundled HA profile).
# HA_URL=http://192.168.1.10:8123
HA_TOKEN=

# Pipeline ports. Change them here, then run `docker compose up -d` again.
# All services use host networking, so choose unused ports on the Docker host.
# The app URL and go2rtc health check follow GO2RTC_API_PORT automatically.
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
# WebRTC uses this port for both TCP and UDP; allow it from viewing devices.
GO2RTC_WEBRTC_PORT=8555

# Optional fake camera (--profile demo).
DEMO_API_PORT=1985
DEMO_RTSP_PORT=8654
# When adding it in the app, use rtsp://localhost:<DEMO_RTSP_PORT>/demo.

# Optional external go2rtc API URL. Leave unset to follow GO2RTC_API_PORT.
# Setting this overrides the app's URL only; it does not move the bundled
# go2rtc listeners or stop that service. Also supported outside Docker.
# GO2RTC_URL=http://192.168.1.10:1984

# API server. The Vite dev server proxies /api to this port.
PORT=3000
HOST=0.0.0.0

# Where config.json is stored.
DATA_DIR=./data
